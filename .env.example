# Copy to .env and adjust if needed. .env is ignored by git.
# Paths may be absolute or relative to the repository directory.
SANDBOX_WORKSPACE=./workspace
SANDBOX_STATE_DIR=./state

SANDBOX_TZ=America/Los_Angeles
SANDBOX_LOCALE=en_US.UTF-8

# File ownership inside the workspace (defaults match the first WSL user).
# install.sh writes your current host uid/gid here automatically.
SANDBOX_UID=1000
SANDBOX_GID=1000

# Optional: explicit Clash Verge Rev configuration directory.
# Leave empty to auto-detect on Windows/WSL, macOS, and Linux.
SANDBOX_VERGE_DIR=

# Optional for slow apt mirrors: a host such as mirrors.ustc.edu.cn
# (no https:// prefix). Used only while building the image.
APT_MIRROR=
